  keywords = {Computer Science - Machine Learning,Computer Science - Robotics,notion},
  file = {/Users/frankcholula/Zotero/storage/5A45LGGV/Black et al. - 2024 - $π_0$ A Vision-Language-Action Flow Model for General Robot Control.pdf;/Users/frankcholula/Zotero/storage/2GX2IVYY/2410.html}
}

@misc{chenNeuralOrdinaryDifferential2019,
